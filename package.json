{
  "name": "tagmix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A searchable barbershop tag library with cropped sheet music and a four-part practice mixer.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:https-proxy": "node scripts/https-proxy.mjs",
    "lint": "eslint .",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "smoke:accounts": "node scripts/browser-accounts-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.3.4",
    "typescript": "^5.9.2",
    "vitest": "5.0.0"
  }
}
