# Persistent catalog and generated-media cache.
TAGMIX_DATA_DIR=.data

# Durable account database; keep separate from the disposable media cache.
TAGMIX_ACCOUNT_DIR=.accounts

# Set to the public origin when using a reverse proxy, e.g. https://tags.example.com.
# It controls same-origin account requests and Secure session cookies.
# TAGMIX_APP_ORIGIN=https://tags.example.com

# Docker's host-side bind address. The systemd service sets this to 127.0.0.1
# for nginx; local Docker use defaults to 0.0.0.0 for LAN access.
# TAGMIX_BIND_ADDRESS=127.0.0.1

# How long catalog metadata remains fresh (milliseconds). Default: 24 hours.
TAGMIX_CATALOG_TTL_MS=86400000

# Optional source/API overrides, primarily for testing mirrors.
# BARBERSHOP_TAGS_API_URL=https://www.barbershoptags.com/api.php
# BARBERSHOP_TAGS_ORIGIN=https://www.barbershoptags.com

# Required only when MIDI learning tracks are encountered.
# TAGMIX_SOUNDFONT=/usr/share/sounds/sf2/FluidR3_GM.sf2
