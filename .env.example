# Persistent catalog and generated-media cache.
TAGMIX_DATA_DIR=.data

# How long catalog metadata remains fresh (milliseconds). Default: 24 hours.
TAGMIX_CATALOG_TTL_MS=86400000

# Optional source/API overrides, primarily for testing mirrors.
# BARBERSHOP_TAGS_API_URL=https://www.barbershoptags.com/api.php
# BARBERSHOP_TAGS_ORIGIN=https://www.barbershoptags.com

# Required only when MIDI learning tracks are encountered.
# TAGMIX_SOUNDFONT=/usr/share/sounds/sf2/FluidR3_GM.sf2
